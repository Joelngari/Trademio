rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    // Check user's role from their user profile doc
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users collection
    match /users/{userId} {
      // Admins can read any user. Users can read their own profile.
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      // Admins can write any user. Users can update their own profile but cannot change uid.
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == userId && request.resource.data.uid == request.auth.uid);
    }

    // Packages: readable by authenticated users, writable by admins
    match /packages/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Traders collection: admin full access; traders can read/write their own document
    match /traders/{traderId} {
      allow read, write: if isAdmin() || (isSignedIn() && request.auth.uid == traderId);
    }

    // Marketers collection: admin full access; marketers can read/write their own document
    match /marketers/{marketerId} {
      allow read, write: if isAdmin() || (isSignedIn() && request.auth.uid == marketerId);
    }

    // Sessions: admin can manage, authenticated users can read
    match /sessions/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Transactions: authenticated users can read (for history), admin can write
    match /transactions/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Earnings
    match /earnings/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Withdrawals
    match /withdrawals/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Marketer payouts and commissions (admin only writes)
    match /marketerPayouts/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /commissions/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Settings: readable by authenticated users, writable by admin
    match /settings/{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
